# Creator OS environment. Copy to `.env` (`node infra/scripts/init-env.mjs` does this and generates secrets).
# NEVER commit .env. Losing ENCRYPTION_KEY means stored OAuth tokens / TOTP secrets become unreadable
# (you would simply reconnect integrations) - back it up separately from database backups.

# ---- public address -------------------------------------------------------------------------------
# What you type in the browser. With Tailscale Serve this is https://<machine>.<tailnet>.ts.net
APP_BASE_URL=http://localhost:8080
# Extra browser origins allowed to call the API (comma separated). Same-origin requests always work.
# Add your LAN address so http://192.168.x.x:8080 works too.
ALLOWED_ORIGINS=http://localhost:8080
# Host port Caddy listens on (LAN HTTP). Tailscale Serve proxies HTTPS to this port.
HTTP_PORT=8080

# ---- secrets (generated by init-env; do not reuse) ---------------------------------------------------
POSTGRES_PASSWORD=change-me
ENCRYPTION_KEY=change-me-at-least-16-chars
AGENT_PAIRING_SECRET=change-me-at-least-16-chars
WORKFLOW_WEBHOOK_SECRET=change-me-at-least-16-chars

# ---- data ----------------------------------------------------------------------------------------------
POSTGRES_USER=creatoros
POSTGRES_DB=creatoros
# Used by host-run tools (pnpm dev, db:migrate). Containers get their own value from docker-compose.yml.
DATABASE_URL=postgres://creatoros:change-me@127.0.0.1:5432/creatoros
REDIS_URL=redis://127.0.0.1:6379
# Previews, attachments and backups live under DATA_DIR (a Docker volume in compose).
DATA_DIR=./.data
MEDIA_PREVIEW_MAX_GB=20

# ---- scanner agent ---------------------------------------------------------------------------------------
# The agent runs on the Windows host, the API runs in Docker. When the agent reports 127.0.0.1/localhost the API
# rewrites it to this host name so a container can reach the host.
AGENT_LOOPBACK_HOST=host.docker.internal
AGENT_TOKEN_TTL_DAYS=90
PAIRING_CODE_TTL_MINUTES=30
AGENT_OFFLINE_AFTER_SECONDS=120

# ---- operations ----------------------------------------------------------------------------------------------
LOG_LEVEL=info
LOGIN_RATE_LIMIT_PER_MINUTE=10
GLOBAL_RATE_LIMIT_PER_MINUTE=600

# ---- optional integrations (leave empty until you have credentials; the UI shows exactly what is missing) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an Authorised redirect URI in Google Cloud: <APP_BASE_URL>/api/v1/integrations/oauth/callback
GOOGLE_REDIRECT_URI=
# Optional: a SEPARATE Google OAuth client for YouTube (e.g. a different Google account/project than Gmail).
# If YOUTUBE_GOOGLE_CLIENT_ID is empty, YouTube uses the GOOGLE_* client above. The redirect URI falls back to
# GOOGLE_REDIRECT_URI (same callback path); add it to the YouTube client's authorised redirect URIs too.
YOUTUBE_GOOGLE_CLIENT_ID=
YOUTUBE_GOOGLE_CLIENT_SECRET=
YOUTUBE_GOOGLE_REDIRECT_URI=

# ---- Meta: Instagram API with Instagram Login (OAuth) ----
# Use the INSTAGRAM app id/secret (Meta app -> Instagram -> API setup with Instagram login), not the Facebook app id.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Must exactly match "OAuth redirect URIs" in Business login settings: <APP_BASE_URL>/api/v1/integrations/meta/instagram/callback
INSTAGRAM_REDIRECT_URI=
# Any long random string; paste the same value into the Meta webhook configuration.
META_WEBHOOK_VERIFY_TOKEN=
# Facebook Pages (Messenger + Page comments). These are the PARENT Meta app id/secret (App settings > Basic),
# not the Instagram app id/secret. Redirect URI default: <APP_BASE_URL>/api/v1/integrations/meta/facebook/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=
META_GRAPH_VERSION=v23.0
META_GATEWAY_PORT=8081
