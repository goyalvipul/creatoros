{
	admin off
	auto_https off
	servers {
		# Tailscale Serve (and Docker's NAT) connect from private addresses; trust their X-Forwarded-Proto so the
		# API sets Secure cookies when the browser is on https.
		trusted_proxies static private_ranges
	}
}

:80 {
	# TikTok fetches the URL-prefix file itself and rejects a changed body, a redirect, or a login page.
	@compressible not path /tiktok0UrAw5La8GcDJDrdA5wk8dSnwzey02mT.txt
	encode @compressible zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		X-Frame-Options SAMEORIGIN
		# microphone=(self) is required for Dictate. microphone=() blocks it in desktop Chrome; phone browsers often ignore that.
		Permissions-Policy "camera=(), microphone=(self), geolocation=()"
		-Server
	}

	# One origin for everything: /api -> Fastify, everything else -> Next.js
	# Cloudflare cached an older /sw.js that saved every page and then failed the
	# navigation when that save failed. These scripts never answer a request.
	# CDN-Cache-Control tells Cloudflare not to store the next copy. The reset
	# query is a new address, so a browser can replace the cached worker now.
	handle /tiktok0UrAw5La8GcDJDrdA5wk8dSnwzey02mT.txt {
		header Content-Type "text/plain; charset=utf-8"
		header Cache-Control "no-store, no-transform"
		header CDN-Cache-Control "no-store"
		respond "tiktok-developers-site-verification=0UrAw5La8GcDJDrdA5wk8dSnwzey02mT" 200
	}

	handle /sw.js {
		header Service-Worker-Allowed "/"
		header Cache-Control "no-store, max-age=0"
		header CDN-Cache-Control "no-store"
		header Content-Type "application/javascript; charset=utf-8"
		respond `self.addEventListener('install', (event) => {event.waitUntil(self.skipWaiting());});self.addEventListener('activate', (event) => {event.waitUntil(caches.keys().then((keys) => Promise.all(keys.filter((key) => key.startsWith('cos-')).map((key) => caches.delete(key)))).then(() => self.clients.claim()),);});function safePath(value) {return typeof value === 'string' && value.charAt(0) === '/' && value.charAt(1) !== '/' ? value : '/notifications';}self.addEventListener('push', (event) => {let data = {};try {data = event.data ? event.data.json() : {};} catch {data = {};}const title = typeof data.title === 'string' ? data.title.slice(0, 120) : 'Kemokem';const body = typeof data.body === 'string' ? data.body.slice(0, 180) : '';const url = safePath(data.url);const tag = typeof data.tag === 'string' ? data.tag.slice(0, 80) : 'kemokem';const badge = typeof data.badge === 'number' && data.badge >= 0 ? Math.min(99, Math.floor(data.badge)) : null;event.waitUntil(Promise.all([self.registration.showNotification(title, {body,tag,data: { url },icon: '/brand/kemokem-pwa-192.png',}),badge === null? Promise.resolve(): badge > 0 && navigator.setAppBadge? navigator.setAppBadge(badge).catch(() => {}): navigator.clearAppBadge? navigator.clearAppBadge().catch(() => {}): Promise.resolve(),]),);});self.addEventListener('notificationclick', (event) => {event.notification.close();const url = safePath(event.notification.data && event.notification.data.url);const absolute = new URL(url, self.location.origin).href;event.waitUntil(self.clients.matchAll({ type: 'window', includeUncontrolled: true }).then((list) => {for (const client of list) {if (client.url.indexOf(self.location.origin) === 0 && client.navigate) {client.focus();return client.navigate(absolute);}}if (self.clients.openWindow) return self.clients.openWindow(absolute);}),);});` 200
	}
	handle /api/sw.js {
		header Service-Worker-Allowed "/"
		header Cache-Control "no-store, max-age=0"
		header CDN-Cache-Control "no-store"
		header Content-Type "application/javascript; charset=utf-8"
		respond `self.addEventListener('install', (event) => {event.waitUntil(self.skipWaiting());});self.addEventListener('activate', (event) => {event.waitUntil(caches.keys().then((keys) => Promise.all(keys.filter((key) => key.startsWith('cos-')).map((key) => caches.delete(key)))).then(() => self.clients.claim()),);});function safePath(value) {return typeof value === 'string' && value.charAt(0) === '/' && value.charAt(1) !== '/' ? value : '/notifications';}self.addEventListener('push', (event) => {let data = {};try {data = event.data ? event.data.json() : {};} catch {data = {};}const title = typeof data.title === 'string' ? data.title.slice(0, 120) : 'Kemokem';const body = typeof data.body === 'string' ? data.body.slice(0, 180) : '';const url = safePath(data.url);const tag = typeof data.tag === 'string' ? data.tag.slice(0, 80) : 'kemokem';const badge = typeof data.badge === 'number' && data.badge >= 0 ? Math.min(99, Math.floor(data.badge)) : null;event.waitUntil(Promise.all([self.registration.showNotification(title, {body,tag,data: { url },icon: '/brand/kemokem-pwa-192.png',}),badge === null? Promise.resolve(): badge > 0 && navigator.setAppBadge? navigator.setAppBadge(badge).catch(() => {}): navigator.clearAppBadge? navigator.clearAppBadge().catch(() => {}): Promise.resolve(),]),);});self.addEventListener('notificationclick', (event) => {event.notification.close();const url = safePath(event.notification.data && event.notification.data.url);const absolute = new URL(url, self.location.origin).href;event.waitUntil(self.clients.matchAll({ type: 'window', includeUncontrolled: true }).then((list) => {for (const client of list) {if (client.url.indexOf(self.location.origin) === 0 && client.navigate) {client.focus();return client.navigate(absolute);}}if (self.clients.openWindow) return self.clients.openWindow(absolute);}),);});` 200
	}
	handle /api/clear-site {
		header Cache-Control "no-store, max-age=0"
		header CDN-Cache-Control "no-store"
		header Content-Type "text/html; charset=utf-8"
		respond `<!doctype html><html lang="en"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Clearing Kemokem</title><p id="m">Clearing the saved copy of this site. The app will open when that is done.</p><script data-cfasync="false">(function(){var m=document.getElementById('m');function fail(e){m.textContent='This tab could not clear the saved copy. Close every Kemokem window, including the installed app, then open this page again. '+(e&&e.message?e.message:'');}if(!('serviceWorker' in navigator)){location.replace('/');return;}var done=false;function go(){if(done)return;done=true;location.replace('/');}navigator.serviceWorker.addEventListener('controllerchange',function(){var c=navigator.serviceWorker.controller;if(c&&c.scriptURL.indexOf('reset=4')!==-1)go();});navigator.serviceWorker.register('/api/sw.js?reset=4',{scope:'/'}).then(function(reg){function watch(w){if(!w||w.state==='redundant'){fail(new Error('the replacement did not start'));return;}if(w.state==='activated'){var c=navigator.serviceWorker.controller;if(c&&c.scriptURL.indexOf('reset=4')!==-1)go();return;}w.addEventListener('statechange',function(){watch(w);});}watch(reg.installing||reg.waiting||reg.active);}).catch(fail);setTimeout(function(){if(!done)m.textContent='Still clearing. Close every Kemokem window, then open this page again.';},8000);})();</script></html>` 200
	}

	handle /api/* {
		reverse_proxy api:4000 {
			# media streaming: never buffer
			flush_interval -1
			transport http {
				response_header_timeout 5m
			}
		}
	}

	handle {
		reverse_proxy web:3000
	}

	log {
		output stdout
		format filter {
			# the Meta handshake carries the verify token in the query string: never log it
			request>uri query {
				replace hub.verify_token REDACTED
				replace hub_verify_token REDACTED
				replace hub.challenge REDACTED
				replace access_token REDACTED
				replace refresh_token REDACTED
				replace client_secret REDACTED
				replace code REDACTED
				replace state REDACTED
			}
			wrap console
		}
	}
}

# Restricted public gateway for signed webhooks only. Everything else answers 404, so exposing this port (for example with
# `tailscale funnel --bg --https=10000 http://127.0.0.1:8081`) never exposes the dashboard or the rest of the API.
:8081 {
	@webhook path /api/v1/integrations/meta/instagram/webhook /api/v1/integrations/meta/facebook/webhook /api/v1/integrations/tiktok/webhook
	handle @webhook {
		request_body {
			max_size 256KB
		}
		reverse_proxy api:4000
	}
	handle {
		respond "Not found" 404
	}
	log {
		output stdout
		format filter {
			# the Meta handshake carries the verify token in the query string: never log it
			request>uri query {
				replace hub.verify_token REDACTED
				replace hub_verify_token REDACTED
				replace hub.challenge REDACTED
				replace access_token REDACTED
				replace refresh_token REDACTED
				replace client_secret REDACTED
				replace code REDACTED
				replace state REDACTED
			}
			wrap console
		}
	}
}
