{
  "name": "creator-os",
  "version": "1.0.0",
  "private": true,
  "description": "Creator OS - private, self-hosted creative production, publishing, collaboration CRM and action queue",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node infra/scripts/dev.mjs",
    "build": "pnpm -r --workspace-concurrency=1 --if-present build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --workspace-concurrency=1 --if-present test",
    "test:unit": "pnpm -r --if-present test:unit",
    "test:integration": "pnpm --filter @creatoros/tests-integration test",
    "test:e2e": "pnpm --filter @creatoros/tests-e2e test",
    "test:agent": "node infra/scripts/go.mjs test ./...",
    "db:generate": "pnpm --filter @creatoros/db generate",
    "db:migrate": "pnpm --filter @creatoros/db migrate",
    "db:seed:demo": "pnpm --filter @creatoros/api seed:demo",
    "agent:build": "node infra/scripts/build-agent.mjs",
    "backup": "node infra/scripts/backup.mjs",
    "restore": "node infra/scripts/restore.mjs",
    "diagnostics": "node infra/scripts/diagnostics.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:unit"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2"
  }
}
